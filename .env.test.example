# Branchwork test environment
# WARNING: NODE_ENV=test enables TypeORM dropSchema.
# This database will have its schema dropped and recreated by the test configuration.
NODE_ENV=test
PORT=3001

# Use a dedicated test database. Its name MUST end with "_test".
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=replace_with_your_local_postgres_password
DB_NAME=branchwork_test

# Use a separate secret for tests.
JWT_SECRET=replace_with_a_separate_test_secret
JWT_EXPIRES_IN=1h
